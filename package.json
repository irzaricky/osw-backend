{
  "name": "osw-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "nodemon": "nodemon --expose-gc ./bin/www",
    "dev-win": "set DEBUG=express:* & nodemon  --expose-gc ./bin/www",
    "dev": "DEBUG=express:* nodemon --expose-gc ./bin/www",
    "start": "node --expose-gc ./bin/www",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-ws": "^5.0.2",
    "hashids": "^2.3.0",
    "http-errors": "^2.0.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pdfmake": "^0.3.3",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "xlsx-populate": "^1.21.0"
  }
}
